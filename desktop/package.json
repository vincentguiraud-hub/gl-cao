{
  "name": "gl-cao-desktop",
  "productName": "G&L CAO 3D",
  "version": "1.1.0",
  "description": "G&L CAO 3D – logiciel de CAO 3D de G&L Créations",
  "author": "G&L Créations",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.glcreations.cao3d",
    "productName": "G&L CAO 3D",
    "files": ["main.cjs", "icon.png", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "G&L CAO 3D", "artifactName": "GL-CAO-3D-Setup.${ext}", "installerIcon": "icon.ico", "uninstallerIcon": "icon.ico" },
    "publish": [{ "provider": "github", "owner": "vincentguiraud-hub", "repo": "gl-cao", "releaseType": "release" }]
  }
}
